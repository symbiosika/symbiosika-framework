# Docker Compose project name (optional, default: app)
# PROJECT_NAME=symbiosika-framework

# Webserver
WRITE_DEBUG_FILES=true
CRON_LOG=true

# When true, unexpected (non-HTTPException) errors include the raw error message
# in the 500 response body as a "detail" field. Leave unset/false in production.
# API_DETAIL_ERROR_MESSAGES=false

# URL
# BASE_URL=http://localhost:3000

# Database
# For local development without an external Postgres you can run an embedded
# PGlite database that speaks the Postgres wire protocol over a socket:
#   Terminal 1:  bun run db:local        (starts PGlite on localhost:5432)
#   Terminal 2:  bun run framework:migrate && bun run dev
# The app connects via the normal POSTGRES_* vars below (host=localhost).
# POSTGRES_USER/PASSWORD/DB may be any value (PGlite ignores authentication).
# Optional: LOCAL_DB_DIR (default ./dev-db/pglite), LOCAL_DB_MAX_CONNECTIONS (default 20).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pg
POSTGRES_PASSWORD=pg
POSTGRES_DB=dev
# POSTGRES_CONNECTION_POOL_SIZE=10

#POSTGRES_CA='-----BEGIN CERTIFICATE-----
#xxx
#-----END CERTIFICATE-----'
# Set to true to verify server hostname against the certificate (default: false)
#POSTGRES_CHECK_IDENTITY=false

# Webserver Settings
# ALLOWED_ORIGINS="http://localhost:5173"

# Parsing
#PDF_PARSER_SERVICE="llama"
#PDF_PARSER_SERVICE="local"
#PDF_PARSER_SERVICE="mistral"
#PDF_PARSER_SERVICE="generic"
#LOCAL_PDF_PARSER_API_KEY="demo-xxx"
#LOCAL_PDF_PARSER_BASE_URL="https://document-services.perlecto.de"
#LLAMA_CLOUD_API_KEY=llx-xxx
# Generic parsing microservice (PDF_PARSER_SERVICE="generic")
#PDF_PARSER_SERVICE_API_KEY="sk-xxx"
#PDF_PARSER_SERVICE_URL="https://parser.example.com"
#PDF_PARSER_SERVICE_MODE="sync" # "sync" (default) | "async"

# MISTRAL_API_KEY
# OPENAI_API_KEY

# AI (text generation)
# Central LLM access for text generation (page summaries, agents, ...).
# Selected like PDF_PARSER_SERVICE. Default "none" = no global LLM: all text
# generation is disabled and features depending on it (e.g. summaries) become
# no-ops. Set a provider AND its API key to enable.
#   AI_PROVIDER=none | mistral | openrouter        (default: none)
# AI_PROVIDER=none
# -- Mistral (AI_PROVIDER=mistral): uses MISTRAL_API_KEY above
# MISTRAL_MODEL=mistral-small-latest
# -- OpenRouter (AI_PROVIDER=openrouter): OpenAI-compatible API
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=mistralai/mistral-large
# OPENROUTER_REFERER=            # optional attribution header
# OPENROUTER_TITLE=              # optional attribution header
# -- Optional cheaper model for knowledge page summaries. When unset, the
#    provider's default model is used. The summary task is trivial, so a small
#    model is recommended.
# KNOWLEDGE_SUMMARY_MODEL=mistral-small-latest
# Debounce window (minutes) before a quiet page's summary is regenerated is NOT
# an env var — it lives in the app-config store (app_specific_data) under the
# key "knowledge_summary_debounce_minutes" as { minutes } (default 60), so it is
# tunable at runtime without a redeploy.

# AI (embeddings)
# Provider for knowledge embeddings. Separate from AI_PROVIDER; default
# "mistral" preserves the historical behaviour. NOTE: switching provider/model
# changes the vector dimension and requires re-embedding existing content.
#   EMBEDDING_PROVIDER=mistral | openrouter         (default: mistral)
# EMBEDDING_PROVIDER=mistral
# MISTRAL_EMBEDDING_MODEL=mistral-embed
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Encryption
# SECRETS_AES_KEY is the master key (key version 1) used to encrypt tenant secrets.
# Existing setups only need this — secrets are stamped with the key version that
# encrypted them (defaults to 1), so a single SECRETS_AES_KEY stays fully backwards compatible.
#
# Key rotation (optional, future): to rotate, add the new key as SECRETS_AES_KEY_V2
# (V3, ...) and set SECRETS_AES_KEY_VERSION to the new current version. New secrets are
# then encrypted with that version while older secrets keep decrypting with their stored
# key version. Leave SECRETS_AES_KEY_VERSION unset to keep using version 1.
SECRETS_AES_KEY=
SECRETS_AES_IV=
# SECRETS_AES_KEY_VERSION=1
# SECRETS_AES_KEY_V2=

JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Email
# Set SMTP_HOST=console.localhost to log emails to console instead of sending
SMTP_DEBUG=true
SMTP_HOST=console.localhost
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_DEFAULT_SENDER=noreply@localhost
SMTP_PASS=

# TLS
# TLS_CERT_PATH=/usr/src/app/certs/server.crt
# TLS_KEY_PATH=/usr/src/app/certs/server.key
# SSRF guard for server-side fetches (outgoing webhooks, URL knowledge import).
# By default the guard blocks targets that resolve to private/internal
# addresses (loopback, RFC1918, link-local incl. cloud metadata).
#
# SSRF_ALLOW_PRIVATE_TARGETS=true disables the internal-address check for ALL
# outgoing requests — only for fully trusted, single-tenant deployments.
# SSRF_ALLOW_PRIVATE_TARGETS=false
#
# SSRF_ALLOWED_HOSTS is the targeted alternative: a comma-separated allowlist of
# specific internal targets to permit while everything else stays protected.
# Entries may be a hostname, an IP literal, or an IPv4 CIDR, e.g.:
#   SSRF_ALLOWED_HOSTS=n8n.internal.example.com,192.168.0.79,10.0.0.0/24
# SSRF_ALLOWED_HOSTS=
