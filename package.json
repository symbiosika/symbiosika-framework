{
  "name": "symbiosika-framework",
  "version": "0.12.8",
  "author": "Symbiosika GmbH",
  "main": "./lib/index.js",
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-pgvector": "^0.0.11",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@types/bun": "^1.4.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@hono/standard-validator": "^0.4.0",
    "@hono/swagger-ui": "0.6.1",
    "@hono/valibot-validator": "0.6.1",
    "@mozilla/readability": "^0.6.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@ai-sdk/mistral": "^4.0.66",
    "@ai-sdk/openai-compatible": "~3.0.71",
    "@ai-sdk/valibot": "^3.0.62",
    "ai": "^7.0.143",
    "cron": "4.4.0",
    "csv": "6.6.4",
    "drizzle-orm": "0.45.4",
    "drizzle-valibot": "0.4.2",
    "hono": "4.13.13",
    "hono-openapi": "1.3.5",
    "jsonwebtoken": "9.0.3",
    "linkedom": "^0.18.13",
    "nanoid": "6.0.2",
    "nodemailer": "10.1.2",
    "pg": "8.23.1",
    "pgvector": "0.3.0",
    "postgres": "3.4.9",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "valibot": "^1.5.0",
    "@simplewebauthn/server": "^14.0.3"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "description": "Backend framework for multi-tenant SaaS apps on Bun, Hono, PostgreSQL and Drizzle ORM",
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "lib/**/*",
    "static/**/*",
    "public/**/*",
    "drizzle-sql/**/*"
  ],
  "types": "./lib/index.d.ts",
  "homepage": "https://github.com/symbiosika/symbiosika-framework",
  "keywords": [],
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun --hot run demo.ts",
    "dev:inspect": "bun --inspect --hot run demo.ts",
    "db:local": "bun run ./.scripts/local-db-server.ts",
    "test:local": "bun run ./.scripts/test-local.ts",
    "db:query": "bun run ./.scripts/db-query.ts",
    "dev:local": "pglite-server --db=./dev-db/pglite --extensions=vector -m 20 -p 5432 --run 'bun run framework:migrate && bun run dev'",
    "framework:migrate": "drizzle-kit migrate",
    "framework:push": "drizzle-kit push",
    "framework:generate": "drizzle-kit generate",
    "framework:studio": "drizzle-kit studio",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit -p tsconfig.strict-check.json",
    "clean": "rm -rf ./lib/",
    "release:patch": "tsc && npm version patch && git push --follow-tags && npm publish",
    "release:minor": "tsc && npm version minor && git push --follow-tags && npm publish",
    "release:major": "tsc && npm version major && git push --follow-tags && npm publish",
    "sync-skills": "bun run ./.scripts/sync-skills.ts",
    "init": "bun run ./.scripts/init.ts"
  }
}
